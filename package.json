{
  "name": "p-ratelimit",
  "version": "2.0.0-beta.1",
  "description": "Promise-based utility to make sure you don’t call rate-limited APIs too quickly.",
  "repository": "natesilva/p-ratelimit",
  "license": "MIT",
  "author": "Nate Silva <nate@natesilva.com>",
  "type": "module",
  "scripts": {
    "clean": "del-cli dist",
    "build": "tsdown",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "tsc && biome check",
    "lint:fix": "tsc && biome check --fix"
  },
  "keywords": [
    "ratelimit",
    "concurrency",
    "promise",
    "promises",
    "limit",
    "throttle",
    "tokenbucket"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/ioredis": "^4.17.8",
    "@types/node": "^22.19.19",
    "@types/redis": "^2.8.28",
    "del-cli": "^7.0.0",
    "ioredis": "^4.19.2",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  }
}
